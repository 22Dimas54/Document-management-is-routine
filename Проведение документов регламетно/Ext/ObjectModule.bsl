#Область ОписаниеПеременных

// Признак для идентификации типа операции в регистре сведений
Перем Признак;

// Максимальное количество попыток проведения одного документа
Перем КоличествоПопытокПроведения;

// Максимальное время ожидания снятия блокировки (в секундах)
Перем МаксимальноеВремяОжиданияБлокировки;

// Шаг увеличения времени ожидания блокировки (в секундах)
Перем ШагУвеличенияВремениОжиданияБлокировки;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Функция возвращает информацию о внешней обработке для регистрации в системе
//
// Возвращаемое значение:
//   Структура - информация о внешней обработке
Функция СведенияОВнешнейОбработке() Экспорт
	
	РегистрационныеДанные = Новый Структура;
	РегистрационныеДанные.Вставить("Наименование", "Проведение документов");
	РегистрационныеДанные.Вставить("ФормированиеФоновогоЗадания", Истина);
	РегистрационныеДанные.Вставить("ВерсияБСП", "1.2.4.1");
	РегистрационныеДанные.Вставить("Версия", "1.0");
	РегистрационныеДанные.Вставить("Информация", "Проведение документов");
	
	ТЗКоманд = Новый ТаблицаЗначений;
	ТЗКоманд.Колонки.Добавить("Идентификатор");
	ТЗКоманд.Колонки.Добавить("Представление");
	
	СтрокаКоманды = тзКоманд.Добавить();
	СтрокаКоманды.Идентификатор = Новый УникальныйИдентификатор;
	СтрокаКоманды.Представление = "Проведение документов";
	
	РегистрационныеДанные.Вставить("Команды", ТЗКоманд);
	
	Возврат РегистрационныеДанные;
	
КонецФункции

// Выполняет перепроведение документов в установленном периоде
//
// Параметры:
//   ИдентификаторКоманды - Строка - идентификатор выполняемой команды
//   ПараметрыОбработки - Структура - параметры выполнения обработки
Процедура ВыполнитьКоманду(ИдентификаторКоманды, ПараметрыОбработки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторКоманды) Тогда
		ВызватьИсключение "Не указан идентификатор команды";
	КонецЕсли;
	
	Если НЕ ПериодУстановлен() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Проведение документов.Начало'"),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Начато проведение документов за период: " + ДатаНачала + " - " + ДатаОкончания
		);
		ОбщегоНазначения.СообщитьИнформациюПользователю("Начато проведение документов за период: " + ДатаНачала + " - " + ДатаОкончания);
		ЗаполнитьТаблицуВидовДокументов();
		УстановкаВидовДокументовДляПроведения();
		ПроведениеДокументов();
		НаборЗаписей = РегистрыСведений.сибиарДанныеДляРегламентнойРаботы.СоздатьНаборЗаписей();
		НаборЗаписей.Записать();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Проведение документов.Завершение'"),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Проведение документов завершено успешно. Обработано документов: " + СписокДокументов.Количество()
		);
		ОбщегоНазначения.СообщитьИнформациюПользователю("Проведение документов завершено успешно");
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Проведение документов.Ошибка выполнения'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ТекстОшибки
		);
		ОбщегоНазначения.СообщитьИнформациюПользователю(
			"При проведении документов произошла ошибка. Обратитесь к администратору. " +
			"Подробности в журнале регистрации."
		);
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Проверяет, установлен ли период для проведения документов
// Возвращает Истина, если в регистре сведений найдены даты начала и окончания
//
// Возвращаемое значение:
//   Булево - признак установки периода проведения
Функция ПериодУстановлен()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	сибиарДанныеДляРегламентнойРаботы.ДатаНачала КАК ДатаНачала,
		|	сибиарДанныеДляРегламентнойРаботы.ДатаОкончания КАК ДатаОкончания
		|ИЗ
		|	РегистрСведений.сибиарДанныеДляРегламентнойРаботы КАК сибиарДанныеДляРегламентнойРаботы
		|ГДЕ
		|	сибиарДанныеДляРегламентнойРаботы.Признак = &Признак";
	
	Запрос.УстановитьПараметр("Признак", Признак);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДатаНачала = Выборка.ДатаНачала;
		ДатаОкончания = КонецДня(Выборка.ДатаОкончания);
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Заполняет таблицу видов документов всеми доступными документами из метаданных
// Используется для формирования списка документов, доступных для проведения
Процедура ЗаполнитьТаблицуВидовДокументов()
	
	// Перебираем все документы в метаданных и добавляем их в таблицу видов документов
	// По умолчанию все документы отмечены для выбора
	Для Каждого СтрокаМетаданных Из Метаданные.Документы Цикл
		НоваяСтрока = ВидыДокументов.Добавить();
		НоваяСтрока.Имя = СтрокаМетаданных.Имя;
		НоваяСтрока.Наименование = СтрокаМетаданных.Синоним;
		НоваяСтрока.Выбор = Истина;
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает выборку документов для проведения
// Отмечает только те виды документов, которые необходимо провести повторно
Процедура УстановкаВидовДокументовДляПроведения()
	
	Для Каждого СтрокаВидыДокументов Из ВидыДокументов Цикл
		СтрокаВидыДокументов.Выбор = Ложь;
	КонецЦикла;
	
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить("АвансовыйОтчет");
	МассивДокументов.Добавить("РеализацияТоваровУслуг");
	МассивДокументов.Добавить("ПоступлениеТоваровУслуг");
	МассивДокументов.Добавить("ПоступлениеДопРасходов");
	МассивДокументов.Добавить("ВозвратТоваровОтПокупателя");
	МассивДокументов.Добавить("ВозвратТоваровПоставщику");
	МассивДокументов.Добавить("ОприходованиеТоваров");
	МассивДокументов.Добавить("ПеремещениеТоваров");
	МассивДокументов.Добавить("СписаниеТоваров");
	МассивДокументов.Добавить("КорректировкаДолга");
	МассивДокументов.Добавить("ПриходныйКассовыйОрдер");
	МассивДокументов.Добавить("РасходныйКассовыйОрдер");
	МассивДокументов.Добавить("ПлатежноеПоручениеВходящее");
	МассивДокументов.Добавить("ПлатежноеПоручениеИсходящее");
	МассивДокументов.Добавить("ПлатежноеТребованиеВыставленное");
	МассивДокументов.Добавить("ПлатежноеТребованиеПолученное");
	МассивДокументов.Добавить("ОтчетОРозничныхПродажах");
	МассивДокументов.Добавить("КомплектацияНоменклатуры");
	МассивДокументов.Добавить("ТребованиеНакладная");
	МассивДокументов.Добавить("АктОбОказанииПроизводственныхУслуг");
	МассивДокументов.Добавить("КорректировкаКачестваТоваров");
	МассивДокументов.Добавить("ОтчетПроизводстваЗаСмену");
	МассивДокументов.Добавить("ВозвратМатериаловИзЭксплуатации");
	МассивДокументов.Добавить("ГТДИмпорт");
	МассивДокументов.Добавить("КорректировкаСерийИХарактеристикТоваров");
	МассивДокументов.Добавить("ОприходованиеМатериаловИзПроизводства");
	МассивДокументов.Добавить("ПередачаМатериаловВЭксплуатацию");
	МассивДокументов.Добавить("ПередачаТоваров");
	МассивДокументов.Добавить("ПоступлениеТоваровИзПереработки");
	МассивДокументов.Добавить("ПринятиеКУчетуОС");
	МассивДокументов.Добавить("КорректировкаРеализации");
	МассивДокументов.Добавить("ПолучениеУслугПоПереработке");
	
	Для Каждого ЭлементМассива Из МассивДокументов Цикл
		СтрокаВидыДокументов = ВидыДокументов.Найти(ЭлементМассива, "Имя");
		Если СтрокаВидыДокументов <> Неопределено Тогда
			СтрокаВидыДокументов.Выбор = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Выполняет перепроведение всех документов из сформированного списка
Процедура ПроведениеДокументов()
	
	ПолучитьСписокДокументовДляПроведения();
	
	ОбщегоНазначения.СообщитьИнформациюПользователю("Найдено документов: " + СписокДокументов.Количество());
	
	Для Каждого Выборка Из СписокДокументов Цикл
		ПровестиДокументСПовторнымиПопытками(Выборка.Ссылка, СписокДокументов.Индекс(Выборка) + 1);
	КонецЦикла;
	
КонецПроцедуры

// Формирует список документов для проведения на основе выбранных видов документов
// Строит динамический запрос UNION ALL для получения документов из разных таблиц
Процедура ПолучитьСписокДокументовДляПроведения()
	
	Текст = "";
	Ном = 0;
	
	Если Метаданные.Справочники.Найти("Организации") <> Неопределено И НЕ Организация.Пустая() Тогда
		ДобавитьУсловиеПоОрганизации = Истина;
		УсловиеПоОрганизации = "
			|	И Документ.Организация = &Организация
			|"
		Иначе
			ДобавитьУсловиеПоОрганизации = Ложь;
		УсловиеПоОрганизации = ""
		КонецЕсли;
	
	Для Каждого СтрокаВидыДокументов Из ВидыДокументов Цикл
		
		Если НЕ СтрокаВидыДокументов.Выбор Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяДокумента = СтрокаВидыДокументов.Имя;
		Если ДобавитьУсловиеПоОрганизации И Метаданные.Документы[ИмяДокумента].Реквизиты.Найти("Организация") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Ном <> 0 Тогда
			Текст = Текст + "
				|ОБЪЕДИНИТЬ ВСЕ
				|"
			КонецЕсли;
		
		Ном = Ном + 1;
		
		Текст = Текст + "
			|ВЫБРАТЬ
			|	Документ.МоментВремени КАК МоментВремени,
			|	Документ.Ссылка
			|ИЗ
			|	Документ." + ИмяДокумента + " КАК Документ
			|ГДЕ
			|	Документ.Проведен = ИСТИНА
			|	И Документ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
			|" + УсловиеПоОрганизации;
		
	КонецЦикла;
	
	Если Текст = "" Тогда
		СписокДокументов.Очистить();
		Возврат;
	КонецЕсли;
	
	Текст = Текст + "
		|УПОРЯДОЧИТЬ ПО
		|	МоментВремени";
	
	Запрос = Новый Запрос;
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	СписокДокументов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

// Проводит документ с повторными попытками при возникновении блокировок
//
// Параметры:
//   ДокументСсылка - ДокументСсылка - ссылка на документ для проведения
//   Счетчик - Число - номер документа в списке для отображения прогресса
//
// Возвращаемое значение:
//   Булево - Истина, если документ проведен успешно; Ложь, если проведение не удалось
Функция ПровестиДокументСПовторнымиПопытками(ДокументСсылка, Счетчик)
	
	Объект = ДокументСсылка.ПолучитьОбъект();
	
	Для Номер = 1 По КоличествоПопытокПроведения Цикл
		Попытка
			ОжидатьСнятияБлокировкиДокумента(Объект, ДокументСсылка);
			Возврат ПопытатьсяПровестиДокумент(Объект, ДокументСсылка, Счетчик);
		Исключение
			Если Объект.Заблокирован() Тогда
				Объект.Разблокировать();
			КонецЕсли;
			ОбщегоНазначения.СообщитьИнформациюПользователю("Пропущен документ: " + ДокументСсылка);
			Номер = Номер + 1;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

// Ожидает снятия блокировки документа
//
// Параметры:
//   Объект - ДокументОбъект - объект документа
//   ДокументСсылка - ДокументСсылка - ссылка на документ для отображения в сообщении пользователю
//
// Возвращаемое значение:
//   Булево - Истина, если блокировка снята успешно; Ложь, если пользователь прервал ожидание
Функция ОжидатьСнятияБлокировкиДокумента(Объект, ДокументСсылка)
	
	ВремяОжидания = 0;
	
	Пока Истина Цикл
		Попытка
			Объект.Заблокировать();
			Возврат Истина;
		Исключение
			Если ВремяОжидания < МаксимальноеВремяОжиданияБлокировки Тогда
				ВремяОжидания = ВремяОжидания + ШагУвеличенияВремениОжиданияБлокировки;
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	
КонецФункции

// Выполняет попытку проведения одного документа с обработкой блокировки
//
// Параметры:
//   Объект - ДокументОбъект - объект документа для проведения
//   ДокументСсылка - ДокументСсылка - ссылка на документ
//   Счетчик - Число - номер документа для отображения прогресса
//
// Возвращаемое значение:
//   Булево - Истина, если документ проведен успешно
Функция ПопытатьсяПровестиДокумент(Объект, ДокументСсылка, Счетчик)
	
	Объект.Записать(РежимЗаписиДокумента.Проведение);
	Объект.Разблокировать();
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область Инициализация

Признак = "Перепроведение";
КоличествоПопытокПроведения = 10;
МаксимальноеВремяОжиданияБлокировки = 60;
ШагУвеличенияВремениОжиданияБлокировки = 5;

#КонецОбласти